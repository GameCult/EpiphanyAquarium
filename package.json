{
  "name": "epiphany-aquarium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1421",
    "smoke:visual": "node scripts/visual-smoke.mjs",
    "bevy": "cargo run --manifest-path bevy-aquarium/Cargo.toml",
    "bevy:dev": "cargo run --manifest-path bevy-aquarium/Cargo.toml --features dev",
    "bevy:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bevy-dev-watch.ps1",
    "bevy:check": "cargo check --manifest-path bevy-aquarium/Cargo.toml",
    "bevy:check:dev": "cargo check --manifest-path bevy-aquarium/Cargo.toml --features dev",
    "tauri": "tauri"
  },
  "dependencies": {
    "@epiphanygraph/epiphany-graph-viewer": "file:../EpiphanyGraph/web/epiphany-graph-viewer",
    "@tauri-apps/api": "2.10.1",
    "lucide-react": "^0.468.0",
    "midi-file": "^1.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.59.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
